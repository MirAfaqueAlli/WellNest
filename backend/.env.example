# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wellnest
DB_USER=root
DB_PASS=your_database_password

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── WhatsApp API (Rextrox) ────────────────────────────────────────────────────
# GET https://wapi.rextrox.in/v2/send?apikey=KEY&recipient=PHONE&text=MSG
# Can also be configured per-hospital in the Hospital Settings UI
WHATSAPP_API_URL=https://wapi.rextrox.in/v2/send
WHATSAPP_API_KEY=your_rextrox_api_key

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL where your frontend is hosted
CLIENT_URL=https://yourdomain.com
